@inproceedings{kamal_eddine_arabart_2022,
	address = {Abu Dhabi, United Arab Emirates (Hybrid)},
	title = {{AraBART}: a {Pretrained} {Arabic} {Sequence}-to-{Sequence} {Model} for {Abstractive} {Summarization}},
