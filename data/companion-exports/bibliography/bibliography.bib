	editor = {Padó, Sebastian and Huang, Ruihong},
	month = nov,
	year = {2019},
	pages = {217--222},
}

@inproceedings{hawasly_dialg2p_2025,
	address = {Suzhou, China},
	title = {{DialG2P}: {Dialectal} {Grapheme}-to-{Phoneme}. {Arabic} as a {Case} {Study}},
	isbn = {979-8-89176-352-4},
	shorttitle = {{DialG2P}},
	url = {https://aclanthology.org/2025.arabicnlp-main.38/},
	doi = {10.18653/v1/2025.arabicnlp-main.38},
	abstract = {Grapheme-to-phoneme (G2P) models are essential components in text-to-speech (TTS) and pronunciation assessment applications. While standard forms of languages have gained attention in that regard, dialectal speech, which often serves as the primary means of spoken communication for many communities, as it is the case for Arabic, has not received the same level of focus. In this paper, we introduce an end-to-end dialectal G2P for Egyptian Arabic, a dialect without standard orthography. Our novel architecture accomplishes three tasks: (i) restores short vowels of the diacritical marks for the dialectal text; (ii) maps certain characters that happen only in the spoken version of the dialectal Arabic to their dialect-specific character transcriptions; and finally (iii) converts the previous step output to the corresponding phoneme sequence. We benchmark G2P on a modular cascaded system, a large language model, and our multi-task end-to-end architecture.},
	urldate = {2026-09-04},
	booktitle = {Proceedings of {The} {Third} {Arabic} {Natural} {Language} {Processing} {Conference}},
	publisher = {Association for Computational Linguistics},
	author = {Hawasly, Majd and Mubarak, Hamdy and Abdelali, Ahmed and Ali, Ahmed},
	editor = {Darwish, Kareem and Ali, Ahmed and Abu Farha, Ibrahim and Touileb, Samia and Zitouni, Imed and Abdelali, Ahmed and Al-Ghamdi, Sharefah and Alkhereyf, Sakhar and Zaghouani, Wajdi and Khalifa, Salam and AlKhamissi, Badr and Almatham, Rawan and Hamed, Injy and Alyafeai, Zaid and Alowisheq, Areeb and Inoue, Go and Mrini, Khalil and Alshammari, Waad},
	month = nov,
	year = {2025},
	pages = {466--471},
}

@article{ramsay_generation_2014,
	title = {Generation of a phonetic transcription for modern standard {Arabic}: {A} knowledge-based model},
	volume = {28},
	issn = {0885-2308},
	shorttitle = {Generation of a phonetic transcription for modern standard {Arabic}},
	url = {https://www.sciencedirect.com/science/article/pii/S0885230814000187},
	doi = {10.1016/j.csl.2014.02.005},
	abstract = {This paper outlines a comprehensive system for automatically generating a phonetic transcription of a given Arabic text which closely matches the pronunciation of the speakers. The presented system is based on a set of (language-dependent) pronunciation rules that works on converting fully diacriticised Arabic text into the actual sounds, along with a lexicon for exceptional words. This is a two-phase process: one-to-one grapheme to phoneme conversion and then phoneme-to-allophone conversion using a set of “phonological rules”. Phonological rules operate on the phonemes and convert them to the actual sounds considering the neighbouring phones or the containing syllable or word. This system is developed for the purpose of delivering a robust Automatic Arabic Speech Recognition (AASR) system which is able to handle speech variation resulting from the mismatch between the text and the pronunciation. We anticipate that it could also be used for producing natural sounding speech from an Arabic text-to-speech (ATTS) system as well, but we have not extensively tested it in this application.},
	number = {4},
	urldate = {2026-09-04},
	journal = {Computer Speech \& Language},
	author = {Ramsay, Allan and Alsharhan, Iman and Ahmed, Hanady},
	month = jul,
	year = {2014},
	keywords = {Speech processing, Modern standard Arabic, Phonetic transcription, Phonological rules, Sound-spelling correspondences},
	pages = {959--978},
}

