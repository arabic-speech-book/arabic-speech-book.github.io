	keywords = {Text processing, Hidden Markov models, Speech processing, Speech synthesis, Hidden Markov model (HMM), HMM-based speech synthesis system, Information processing, Parametric statistics, Statistical learning, statistical parametric speech synthesis, text-to-speech synthesis (TTS)},
