@article{ikrish_spoken_2026,
	title = {Spoken {American} and {Saudi} {Dialects} {Classification} {System} {Using} {Deep} {Learning} {Networks}},
	issn = {2191-4281},
	url = {https://doi.org/10.1007/s13369-026-11578-3},
	doi = {10.1007/s13369-026-11578-3},
	abstract = {Over the last few decades, deep learning systems have achieved significant success in speech-based interaction, including the classification of spoken dialects. Spoken dialect classification using deep learning systems aims to classify speech signals based on their features. In this article, we propose a spoken American and Saudi dialects classification system that compares Convolutional Neural Network (CNN) and Bidirectional Long Short-Term Memory (BLSTM) classifiers with the Texas Instruments Massachusetts Institute of Technology (TIMIT) corpus and Saudi Accented Arabic Voice Bank (SAAVB) using a combination of carefully chosen speech features to uncover fruitful outcomes. After a series of experiments, the accuracies of the proposed systems using the CNN classifier for spoken American dialects classification with prosodic, acoustic, and Rhythm-Metrix features, and all their combinations, achieved 13.12\%, 58.00\%, 51.01\%, and 68.50\%, respectively. Likewise, we achieved classification accuracies of 9.06\%, 32.03\%, 28.78\%, and 48.01\% using the same features for spoken Saudi dialect classification. Compared with the proposed system using the BLSTM classifier, we achieved 21.83\%, 56.03\%, 65.63\%, and 75.87\% for spoken American dialects classification, and 10.18\%, 13.89\%, 47.20\%, and 60.19\% for spoken Saudi dialects classification, using the same features.},
	language = {en},
	urldate = {2026-08-25},
	journal = {Arabian Journal for Science and Engineering},
	author = {Ikrish, Rana F. Bin and Alashban, Adal A. and Alotaibi, Yousef A.},
	month = aug,
	year = {2026},
	keywords = {Deep learning, Arabic, English, Acoustic feature, BLSTM, CNN, Dialects classification, Prosodic feature, SAAVB, TIMIT},
}

@article{chen_wavlm_2022,
	title = {{WavLM}: {Large}-{Scale} {Self}-{Supervised} {Pre}-{Training} for {Full} {Stack} {Speech} {Processing}},
	volume = {16},
	issn = {1941-0484},
	shorttitle = {{WavLM}},
	url = {https://ieeexplore.ieee.org/document/9814838},
	doi = {10.1109/JSTSP.2022.3188113},
	abstract = {Self-supervised learning (SSL) achieves great success in speech recognition, while limited exploration has been attempted for other speech processing tasks. As speech signal contains multi-faceted information including speaker identity, paralinguistics, spoken content, etc., learning universal representations for all speech tasks is challenging. To tackle the problem, we propose a new pre-trained model, WavLM, to solve full-stack downstream speech tasks. WavLM jointly learns masked speech prediction and denoising in pre-training. By this means, WavLM does not only keep the speech content modeling capability by the masked speech prediction, but also improves the potential to non-ASR tasks by the speech denoising. In addition, WavLM employs gated relative position bias for the Transformer structure to better capture the sequence ordering of input speech. We also scale up the training dataset from 60 k hours to 94 k hours. WavLM Large achieves state-of-the-art performance on the SUPERB benchmark, and brings significant improvements for various speech processing tasks on their representative benchmarks.},
	number = {6},
	urldate = {2026-08-25},
	journal = {IEEE Journal of Selected Topics in Signal Processing},
	author = {Chen, Sanyuan and Wang, Chengyi and Chen, Zhengyang and Wu, Yu and Liu, Shujie and Chen, Zhuo and Li, Jinyu and Kanda, Naoyuki and Yoshioka, Takuya and Xiao, Xiong and Wu, Jian and Zhou, Long and Ren, Shuo and Qian, Yanmin and Qian, Yao and Wu, Jian and Zeng, Michael and Yu, Xiangzhan and Wei, Furu},
	month = oct,
	year = {2022},
	keywords = {Predictive models, Benchmark testing, Speech recognition, Speech processing, Self-supervised learning, Convolution, speech pre-training},
	pages = {1505--1518},
}

@inproceedings{radford_robust_2023-1,
	title = {Robust {Speech} {Recognition} via {Large}-{Scale} {Weak} {Supervision}},
	issn = {2640-3498},
	url = {https://proceedings.mlr.press/v202/radford23a.html},
	abstract = {We study the capabilities of speech processing systems trained simply to predict large amounts of transcripts of audio on the internet. When scaled to 680,000 hours of multilingual and multitask supervision, the resulting models generalize well to standard benchmarks and are often competitive with prior fully supervised results without the need for any dataset specific fine-tuning. When compared to humans, the models approach their accuracy and robustness. We are releasing models and inference code to serve as a foundation for further work on robust speech processing.},
